# ---- The database: the SAME Turso database as the student app (copy the two values from the student app's .env) ----
TURSO_DATABASE_URL=libsql://your-database-name-yourname.turso.io
TURSO_AUTH_TOKEN=your-long-token

# ---- The first admin. It is created once, the first time the admin app starts and there is no admin yet. ----
ADMIN_EMAIL=your.admin@gmail.com
ADMIN_PASSWORD=choose-a-long-password-here
ADMIN_NAME=System Admin

# ---- A long random text (at least 32 characters). Only the admin app uses it. Do NOT use the same value as the student app. ----
ADMIN_SECRET=change-this-to-a-long-random-text

# ---- Only if you do NOT set Turso (testing on your computer): the file of the local database ----
# DB_PATH=data/admin-test.sqlite

# Vercel Blob: where the .glb files of the 3D Tools are stored (Vercel > Storage > Blob)
BLOB_READ_WRITE_TOKEN=
